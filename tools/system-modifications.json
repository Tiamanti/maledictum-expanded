  "exterminator cartridge": {
    "name": "Exterminator Cartridge",
    "packId": "impmal-core",
    "item": {
      "name": "Exterminator Cartridge",
      "type": "modification",
      "_id": "BMklaKKiyCUgQfOX",
      "img": "modules/impmal-core/assets/icons/modification/modification.webp",
      "system": {
        "notes": {
          "player": "<p>An Exterminator Cartridge is a stripped-down Flamer with enough fuel for a single use. They are popular among Imperial fanatics and zealots, who attach them to roaring Chainswords to douse their foes in cleansing fire as they charge in a blazing embodiment of the Emperor's fury.</p><p>An Exterminator Cartridge is a @UUID[Compendium.impmal-core.items.Item.blRx8XLXQaD9sjDz]{Flamer} that can be attached to any melee or ranged weapon. It can be fired as an Action, counting as a Ranged Attack. Once an Exterminator Cartridge has been fired, the Exterminator Cartridge is expended and takes 5 minutes to reload. Reloads can be acquired for 5 solars, and are Common.</p>",
          "gm": ""
        },
        "encumbrance": {
          "value": 0
        },
        "cost": 100,
        "availability": "common",
        "quantity": 1,
        "category": "combat",
        "usedWith": "Any Melee or Ranged weapon with the Two-Handed Trait.",
