  "mono-edge": {
    "name": "Mono-edge",
    "packId": "impmal-core",
    "item": {
      "name": "Mono-edge",
      "type": "modification",
      "img": "modules/impmal-core/assets/icons/modification/modification.webp",
      "system": {
        "notes": {
          "player": "<p>Popular among assassins and other fighters who need to pierce armour with ease, Mono-edges are molecule-thin superfine blades that never dull.</p><p>A Mono-edge can be applied to any Mundane bladed melee weapon, granting it the Penetrating (2) Trait, or increasing its Penetrating rating by 2 if it already has the Trait. At the GM's discretion, they may allow other Mundane weapons to use this modification. In this case, the modification takes the form of a powerful pneumatic spike or kill-plate.</p>",
          "gm": ""
        },
        "encumbrance": {
          "value": 0
        },
        "cost": 250,
