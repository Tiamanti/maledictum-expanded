  "omniscope": {
    "name": "Omniscope",
    "packId": "impmal-core",
    "item": {
      "name": "Omniscope",
      "type": "modification",
      "img": "modules/impmal-core/assets/icons/modification/modification.webp",
      "system": {
        "notes": {
          "player": "<p>A basic but most often bulky arrangement of lenses in a sturdy casing, Omniscopes allow the user to see distant targets with greater clarity and precision.</p><p>This sight increases the Range of a compatible ranged weapon by one step, but it loses the @UUID[JournalEntry.wqlquQ8Njtd5fb4Y.JournalEntryPage.wsM53RDPPrqwS3Te#close]{Close} Trait if it has it. An Omniscope can also be used as @UUID[Compendium.impmal-core.items.Item.7lBipnmSZ4lD5WCo]{Magnoculars}.</p>",
          "gm": ""
        },
