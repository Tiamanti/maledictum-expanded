  "fire selector": {
    "name": "Fire Selector",
    "packId": "impmal-core",
    "item": {
      "name": "Fire Selector",
      "type": "modification",
      "img": "modules/impmal-core/assets/icons/modification/modification.webp",
      "system": {
        "notes": {
          "player": "<p>Fire Selectors employ complex magazines that can be loaded with a mix of ammunition that can be toggled at the flick of a switch.</p><p>When loading a weapon with a Fire Selector, you can choose to load up to three different types of @UUID[JournalEntry.wqlquQ8Njtd5fb4Y.JournalEntryPage.luQOhxIEeYF6tMgt#ammunition]{ammunition}. Divide the Magazine between the loaded ammunition types as you desire. You can switch between loaded ammunition using the Fire Selector as a Free Action. Any weapon modified with a Fire Selector loses the @UUID[JournalEntry.wqlquQ8Njtd5fb4Y.JournalEntryPage.wsM53RDPPrqwS3Te#reliable]{Reliable} Trait if it has it.</p>",
          "gm": ""
        },
        "encumbrance": {
          "value": 0
        },
        "cost": 140,
        "availability": "rare",
        "quantity": 1,
        "category": "support",
        "usedWith": "Bolt, Launcher, Low-Tech, and Solid Projectile ranged weapons",
