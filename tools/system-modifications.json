  "omnispex": {
    "name": "Omnispex",
    "packId": "impmal-core",
    "item": {
      "name": "Omnispex",
      "type": "modification",
      "img": "modules/impmal-core/assets/icons/modification/modification.webp",
      "system": {
        "notes": {
          "player": "<p>An Omnispex uses spectral sensors to analyse wavelengths outside of Human perception, so that even in darkness few can hide themselves from detection.</p><p>A Omnispex can be attached to most ranged weapons and removes Disadvantage when firing into a Zone that is @UUID[JournalEntry.hdElQAwiBr5AyoRf.JournalEntryPage.zQYkbNcsJmGintdL#dark]{Dark} or @UUID[JournalEntry.hdElQAwiBr5AyoRf.JournalEntryPage.zQYkbNcsJmGintdL#poorly-lit]{Poorly Lit}.</p>",
          "gm": ""
        },
        "encumbrance": {
          "value": 0
        },
        "cost": 200,
        "availability": "rare",
        "quantity": 1,
        "category": "sight",
        "usedWith": "Any Ranged Weapon without the Blast, or Flamer Traits.",
